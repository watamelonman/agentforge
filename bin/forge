#!/usr/bin/env python3
"""forge - orchestrate Claude Code, Codex, GLM (via Claude Code), Grok Build and OpenCode agents on a spec-driven project.

Stdlib only (Python >= 3.11 for tomllib). See README.md.

This file is only the entry point; the code lives in the agentforge/ package next to bin/
(module map: docs/ARCHITECTURE.md). The package is found relative to this file's resolved
path, so a symlink such as ~/.local/bin/forge works.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from agentforge import *  # noqa: E402,F401,F403  re-exported for tests that load bin/forge as a module
from agentforge.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
