{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake *)", "Bash(ctest *)", "Bash(make *)", "Bash(ninja *)",
      "Bash(cc *)", "Bash(gcc *)", "Bash(clang *)", "Bash(clang-format *)", "Bash(clang-tidy *)",
      "Bash(python3 *)", "Bash(pytest *)", "Bash(lua *)",
      "Bash(dotnet *)", "Bash(godot *)", "Bash(godot-mono *)",
      "Bash(./build/*)", "Bash(ls *)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)",
      "Bash(wc *)", "Bash(grep *)", "Bash(rg *)", "Bash(find *)", "Bash(diff *)",
      "Bash(mkdir *)", "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)"
    ],
    "deny": [
      "Bash(git commit*)", "Bash(git push*)", "Bash(git reset*)", "Bash(git checkout*)",
      "Bash(git switch*)", "Bash(git rebase*)", "Bash(git stash*)", "Bash(rm -rf*)",
      "Bash(sudo *)", "Bash(curl *)", "Bash(wget *)",
      "Edit(AGENTS.md)", "Edit(CLAUDE.md)", "Edit(forge.toml)", "Edit(gates/**)",
      "Edit(schemas/**)", "Edit(prompts/**)", "Edit(spec/**)", "Edit(tasks/**)", "Edit(.claude/**)",
      "Write(gates/**)", "Write(.claude/**)", "Write(forge.toml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh" }]
      }
    ]
  }
}
