root = true
[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = false:suggestion
dotnet_style_require_accessibility_modifiers = always:error
dotnet_diagnostic.IDE0005.severity = error   # unused usings
dotnet_diagnostic.CA1062.severity = none     # nullable annotations cover this
[Game.Core.Tests/**.cs]
dotnet_diagnostic.CS1591.severity = none     # test methods don't need XML docs
dotnet_diagnostic.CA1707.severity = none     # underscores in test names
